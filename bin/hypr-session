#!/bin/bash
# Save and restore the Hyprland session: which apps are open, on which
# workspace, and the exact dwindle layout, silently (nothing is focused or
# shown while it rebuilds). Terminals come back running what they ran
# (Claude Code, Codex and pi resume their session), Chrome reopens its tabs
# and web apps come back as web apps.
#   hypr-session save      snapshot open windows to $STATE
#   hypr-session restore   relaunch saved apps, put them on their workspaces, rebuild the layout
#   hypr-session watch     save on window events and every 15s (started on boot)

STATE="${HYPR_SESSION_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/hypr-session.json}"
RESTORED="${STATE%.json}.restored.json" # copy of what the last boot restored
LOG="${STATE%.json}.log"
EVENTS="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
  (($(wc -l <"$LOG") > 1000)) && sed -i '1,500d' "$LOG"
}

# Omarchy's shutdown, reboot and logout close every window before the session
# ends. Saving then would record a half-closed desktop, so detect it and stop.
shutting_down() {
  pgrep -f 'uwsm stop' >/dev/null && return 0
  [[ $(systemctl is-system-running 2>/dev/null) == stopping ]] && return 0
  local timer
  for timer in $(systemctl --user list-units --type=timer --plain --no-legend 'run-*' 2>/dev/null | awk '{print $1}'); do
    systemctl --user show "${timer%.timer}.service" -p ExecStart --value |
      grep -q -E 'systemctl (poweroff|reboot)' && return 0
  done
  return 1
}

# Chrome names a web app window after its URL: https://discord.com/channels/@me
# becomes chrome-discord.com__channels_@me-Default. Prefer the exact URL from
# the installed web app launchers; fall back to reversing the name.
webapp_url() {
  local id url key file
  id=$(sed -E 's/^chrome-//; s/-(Default|Profile [0-9]+)$//' <<<"$1")
  for file in "$HOME"/.local/share/applications/*.desktop; do
    url=$(sed -n -E 's/^Exec=omarchy-launch-webapp "?([^" ]+)"?.*/\1/p' "$file" | head -1)
    [[ -n $url ]] || continue
    key=${url#*://}
    [[ $key == */* ]] || key+="/"
    key="${key%%/*}_$(tr / _ <<<"/${key#*/}")"
    [[ $key == "$id" ]] && echo "$url" && return
  done
  url=${id#*__}
  echo "https://${id%%__*}/${url//_//}"
}

terminal_cwd() {
  local child
  child=$(pgrep -P "$1" | head -1)
  [[ -n $child ]] && readlink "/proc/$child/cwd"
}

# Seconds since the epoch when process $1 started
proc_start() {
  local ticks boot
  ticks=$(awk '{print $22}' "/proc/$1/stat" 2>/dev/null) || return
  boot=$(awk '/^btime/ {print $2}' /proc/stat)
  echo $((boot + ticks / $(getconf CLK_TCK)))
}

# The program running inside terminal $1 as "<cwd>\t<shell command that
# reopens it>": AI agents come back in the same session, other known TUIs are
# simply started again. Prints nothing for a plain shell.
terminal_program() {
  local queue=("$1") pid name cwd start id
  while ((${#queue[@]})); do
    pid=${queue[0]}
    queue=("${queue[@]:1}" $(pgrep -P "$pid"))
    name=$(cat "/proc/$pid/comm" 2>/dev/null)
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null)
    case $name in
      claude)
        id=$(jq -r '.sessionId // empty' "$HOME/.claude/sessions/$pid.json" 2>/dev/null)
        printf '%s\t%s\n' "$cwd" "claude${id:+ --resume $id}"
        return
        ;;
      codex)
        # Codex logs threads under a shared daemon, so match the thread that was
        # last active in this directory since this codex started
        start=$(proc_start "$pid")
        id=$(sqlite3 -readonly "$HOME/.codex/state_5.sqlite" \
          "select id from threads where cwd = '${cwd//\'/\'\'}' and updated_at >= ${start:-0} order by updated_at desc limit 1" 2>/dev/null)
        printf '%s\t%s\n' "$cwd" "codex${id:+ resume $id}"
        return
        ;;
      pi)
        # pi keeps one file per session in a folder named after the directory
        start=$(proc_start "$pid")
        id=$(find "$HOME/.pi/agent/sessions/--$(tr / - <<<"${cwd#/}")--" -name '*.jsonl' -newermt "@${start:-0}" \
          -printf '%T@ %f\n' 2>/dev/null | sort -rn | head -1 | sed -E 's/.*_([0-9a-f-]+)\.jsonl$/\1/')
        printf '%s\t%s\n' "$cwd" "pi${id:+ --session $id}"
        return
        ;;
      herdr | nvim | vim | btop | htop | lazygit | lazydocker | yazi)
        printf '%s\t%s\n' "$cwd" "$(xargs -0 printf '%q ' <"/proc/$pid/cmdline")"
        return
        ;;
    esac
  done
}

save() {
  local clients entries="[]" pid cmd class windows workspaces geometry cwd program flag
  shutting_down && return
  clients=$(hyprctl clients -j) || return
  [[ $(jq length <<<"$clients") -eq 0 ]] && return # never overwrite with an empty desktop

  # One entry per app and window class: web apps share the browser's process,
  # so grouping by process alone folded them into a single "Chrome" entry.
  while IFS=$'\t' read -r pid class; do
    [[ -r /proc/$pid/cmdline ]] || continue
    windows=$(jq -c --argjson p "$pid" --arg k "$class" '[.[] | select(.pid == $p and .class == $k)] | sort_by(.workspace.id, .at[0], .at[1])' <<<"$clients")
    workspaces=$(jq -c 'map(.workspace.name)' <<<"$windows")
    # Where each window sat, so restore can rebuild the tiling layout
    geometry=$(jq -c 'map({at, size, floating})' <<<"$windows")

    if [[ $class =~ ^chrome-.+-(Default|Profile\ [0-9]+)$ ]]; then
      cmd=$(jq -nc --arg u "$(webapp_url "$class")" '["omarchy-launch-webapp", $u]')
      entries=$(jq -c --argjson c "$cmd" --arg k "$class" --argjson w "$workspaces" --argjson g "$geometry" '. + [{cmd: $c, class: $k, workspaces: $w, geometry: $g}]' <<<"$entries")
      continue
    fi

    # Chromium-based apps rewrite their argv into one space-separated string.
    # Drop --app= so a browser first opened as a web app comes back as a browser.
    cmd=$(jq -Rsc 'split("\u0000") | map(select(. != "")) | if length == 1 then .[0] | split(" ") | map(select(. != "")) else . end | map(select(startswith("--app=") | not))' <"/proc/$pid/cmdline")
    [[ $cmd == "[]" ]] && continue

    # Browsers reopen the tabs of the last session
    case $class in
      google-chrome | chromium | Chromium | brave-browser)
        cmd=$(jq -c 'if index("--restore-last-session") then . else . + ["--restore-last-session"] end' <<<"$cmd")
        ;;
    esac

    # Terminals: reopen in the directory the shell inside them was in, and
    # relaunch the program that was running there (Claude/Codex/pi resume
    # their session), dropping back to a shell when it exits
    case $class in
      foot | Alacritty | com.mitchellh.ghostty | kitty)
        cwd=$(terminal_cwd "$pid")
        program=$(terminal_program "$pid")
        [[ -n ${program%%$'\t'*} ]] && cwd=${program%%$'\t'*}
        if [[ -n $cwd ]]; then
          flag="--working-directory=$cwd"
          [[ $class == kitty ]] && flag="--directory=$cwd"
          cmd=$(jq -c --arg f "$flag" 'map(select(startswith("--working-directory") or startswith("--directory") | not)) | .[:1] + [$f] + .[1:]' <<<"$cmd")
        fi
        if [[ -n $program ]]; then
          # keep the terminal's own --option=value flags, replace whatever it ran
          cmd=$(jq -c --arg c "${program#*$'\t'}; exec ${SHELL:-zsh}" --arg sh "${SHELL:-zsh}" --arg k "$class" \
            '.[:1] + (.[1:] | map(select(startswith("--") and contains("=")))) + (if $k == "foot" or $k == "kitty" then [] else ["-e"] end) + [$sh, "-ic", $c]' <<<"$cmd")
        fi
        ;;
    esac

    entries=$(jq -c --argjson c "$cmd" --arg k "$class" --argjson w "$workspaces" --argjson g "$geometry" '. + [{cmd: $c, class: $k, workspaces: $w, geometry: $g}]' <<<"$entries")
  done < <(jq -r '[.[] | select(.pid > 0)] | sort_by(.workspace.id, .at[0], .at[1]) | .[] | "\(.pid)\t\(.class)"' <<<"$clients" | awk '!seen[$0]++')

  mkdir -p "$(dirname "$STATE")"
  jq . <<<"$entries" >"$STATE.tmp" || return
  if cmp -s "$STATE.tmp" "$STATE"; then
    rm "$STATE.tmp"
  else
    mv "$STATE.tmp" "$STATE"
    log "save: $(jq -r 'map("\(.class)@\(.workspaces | join(","))") | join(" ")' "$STATE")"
  fi
}

move_window() {
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$2\", follow = false, window = \"address:$1\" })" >/dev/null
}

dispatch() { hyprctl dispatch "$1" >/dev/null; sleep 0.15; }

# Turn saved window rectangles into dwindle build steps. Tiled rectangles are
# split recursively by a full-height or full-width cut, which is exactly how
# dwindle divides a workspace. Prints "first <addr>", then "split <addr> <r|d>
# <addr>" meaning: split the first window right/down and move the second in.
# Prints nothing when the rectangles are not a clean dwindle tree.
layout_plan() {
  python3 -c '
import json, sys

TOL = 6

def cut(ws):
    for d, pos, size in (("r", "x", "w"), ("d", "y", "h")):
        for edge in sorted({w[pos] + w[size] for w in ws}):
            first = [w for w in ws if w[pos] + w[size] <= edge + TOL]
            rest = [w for w in ws if w[pos] >= edge - TOL and w not in first]
            if first and rest and len(first) + len(rest) == len(ws):
                return d, first, rest
    return None

def tree(ws):
    if len(ws) == 1:
        return ws[0]["addr"]
    found = cut(ws)
    if not found:
        sys.exit()
    d, first, rest = found
    return (d, tree(first), tree(rest))

def leaf(t):
    return t if isinstance(t, str) else leaf(t[1])

def steps(t, w, out):
    if isinstance(t, str):
        return
    d, a, b = t
    out.append(f"split {w} {d} {leaf(b)}")
    steps(a, w, out)
    steps(b, leaf(b), out)

t = tree(json.load(sys.stdin))
out = [f"first {leaf(t)}"]
steps(t, leaf(t), out)
print("\n".join(out))
' 2>/dev/null
}

restore() {
  [[ -f $STATE ]] || return
  local count i entry class known new addr ws placements claimed before
  cp "$STATE" "$RESTORED"
  # Windows that were already open are never touched
  before=$(hyprctl clients -j | jq -c 'map(.address)')
  claimed=$before

  # An app that hands its window to an instance already running (web apps and
  # new windows of a running Chrome) ignores the launch workspace and would
  # flash on the current one. For every app whose windows all sat on one
  # workspace, a temporary window rule sends them there before they show up.
  local lua="_G.hypr_session_rules = {}" rule_class rule_ws n=0
  while IFS=$'\t' read -r rule_class rule_ws; do
    ((n++))
    rule_class=$(sed 's/[][\.*^$+?(){}|\\]/\\&/g' <<<"$rule_class")
    lua+="; table.insert(_G.hypr_session_rules, hl.window_rule({ name = \"hypr-session-$n\", match = { class = [==[^($rule_class)\$]==] }, workspace = [==[$rule_ws silent]==] }))"
  done < <(jq -r '[.[] | {class, ws: .workspaces[]}] | group_by(.class) | map(select(map(.ws) | unique | length == 1)) | .[] | "\(.[0].class)\t\(.[0].ws)"' "$STATE")
  hyprctl eval "$lua" >/dev/null
  count=$(jq length "$STATE")
  placements=$(mktemp)
  log "restore: $count apps"

  for ((i = 0; i < count; i++)); do
    entry=$(jq -c ".[$i]" "$STATE")
    class=$(jq -r .class <<<"$entry")
    mapfile -t workspaces < <(jq -r '.workspaces[]' <<<"$entry")
    known=$(hyprctl clients -j | jq -c 'map(.address)')

    # A browser restoring its last session reopens its windows and web apps by
    # itself: take those over instead of opening duplicates (only windows that
    # appeared during this restore, see $before)
    if [[ $class =~ ^(google-chrome|chromium|Chromium|brave-browser|chrome-.+)$ ]]; then
      known=$claimed
      sleep 1
    fi
    if ! hyprctl clients -j | jq -e --argjson known "$known" --arg k "$class" \
      'any(.[]; .class == $k and (.address | IN($known[]) | not))' >/dev/null; then
      # Launch straight onto the saved workspace so windows never flash on the current one
      cmd=$(jq -r '.cmd | map(@sh) | join(" ")' <<<"$entry")
      hyprctl dispatch "hl.dsp.exec_cmd([==[$cmd]==], { workspace = \"${workspaces[0]} silent\" })" >/dev/null
    fi

    # Wait up to 20s for the app's windows and send each to its saved workspace
    local placed=0
    for _ in $(seq 40); do
      sleep 0.5
      mapfile -t new < <(hyprctl clients -j | jq -r --argjson known "$known" --arg k "$class" \
        '.[] | select(.class == $k and (.address | IN($known[]) | not)) | .address')
      for addr in "${new[@]}"; do
        ((placed >= ${#workspaces[@]})) && break # never take more windows than were saved
        ws=${workspaces[$placed]}
        move_window "$addr" "$ws"
        jq -c --arg a "$addr" --arg w "$ws" --argjson n "$placed" \
          '.geometry[$n] // empty | {addr: $a, ws: $w, x: .at[0], y: .at[1], w: .size[0], h: .size[1], floating}' \
          <<<"$entry" >>"$placements"
        known=$(jq -c --arg a "$addr" '. + [$a]' <<<"$known")
        claimed=$(jq -c --arg a "$addr" '. + [$a]' <<<"$claimed")
        ((placed++))
      done
      ((placed >= ${#workspaces[@]})) && break
    done
    log "restore: $class ${placed}/${#workspaces[@]} windows -> ${workspaces[*]}"
  done

  arrange "$placements"
  rm -f "$placements"
  hyprctl eval 'for _, r in ipairs(_G.hypr_session_rules or {}) do r:set_enabled(false) end; _G.hypr_session_rules = {}' >/dev/null
}

# Make window $1 the tiled window under the cursor on workspace $2 (the one
# dwindle splits next), by moving the split lines around it. Dwindle's resize
# moves a window's right edge, or its left edge when it touches the right side
# of the workspace (same for bottom/top), so each edge is moved by whichever
# window owns it: the window itself or its neighbour across that edge.
aim() {
  local a=$1 ws=$2 px py axis plan who w h
  read -r px py < <(hyprctl cursorpos | tr -d ',')
  for axis in x y x y; do
    plan=$(hyprctl clients -j | jq -r --arg a "$a" --arg ws "$ws" --arg axis "$axis" --argjson px "$px" --argjson py "$py" '
      def box: {x1: .at[0], y1: .at[1], x2: (.at[0] + .size[0]), y2: (.at[1] + .size[1]), w: .size[0], h: .size[1], addr: .address};
      [.[] | select(.workspace.name == $ws and (.floating | not)) | box] as $t
      | ($t | first(.[] | select(.addr == $a))) as $me
      | {x1: ($t | map(.x1) | min), y1: ($t | map(.y1) | min), x2: ($t | map(.x2) | max), y2: ($t | map(.y2) | max)} as $area
      | 20 as $m
      # a cursor off the workspace counts from the nearest point on it
      | ([[$px, $area.x1 + $m] | max, $area.x2 - $m] | min) as $cx
      | ([[$py, $area.y1 + $m] | max, $area.y2 - $m] | min) as $cy
      | if $axis == "x" then {lo: "x1", hi: "x2", c: $cx, cross_lo: "y1", cross_hi: "y2", len: "w", other: "h"}
        else {lo: "y1", hi: "y2", c: $cy, cross_lo: "x1", cross_hi: "x2", len: "h", other: "w"} end as $k
      | ($area[$k.hi] - $me[$k.hi] < 3) as $at_end
      | if $k.c > $me[$k.hi] then
          # push my far edge forward
          if $at_end then empty else [$me.addr, $me[$k.len] + ($k.c + $m - $me[$k.hi]), $me[$k.other]] end
        elif $k.c < $me[$k.lo] then
          ($k.c - $m - $me[$k.lo]) as $d
          | if $at_end then [$me.addr, $me[$k.len] + $d, $me[$k.other]]
            else
              # the neighbour whose far edge is my near edge pulls it back
              first($t[] | select(.addr != $a and (($me[$k.lo] - .[$k.hi]) | fabs) < 16
                and .[$k.cross_lo] < $me[$k.cross_hi] and .[$k.cross_hi] > $me[$k.cross_lo]))
              | [.addr, .[$k.len] + $d, .[$k.other]]
            end
        else empty end
      | if $axis == "x" then "\(.[0]) \(.[1]) \(.[2])" else "\(.[0]) \(.[2]) \(.[1])" end')
    [[ -n $plan ]] || continue
    read -r who w h <<<"$plan"
    dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = \"address:$who\" })"
  done
}

# Put every restored window back where it was, without ever focusing or
# showing anything: floating ones at their exact position and size, tiled ones
# rebuilt split by split on their (hidden) workspace, then resized.
#
# On a workspace that is not on screen, dwindle splits the window closest to
# the cursor, side by side or stacked depending on split_width_multiplier. So
# for each split: move the split lines until the window to split sits under
# the cursor, pick the direction through that option, and move the next in.
arrange() {
  local placements=$1 ws wins plan op a d b w h x y
  [[ -s $placements ]] || return

  while read -r a x y w h; do
    dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$a\" })"
    dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = \"address:$a\" })"
    dispatch "hl.dsp.window.move({ x = $x, y = $y, window = \"address:$a\" })"
  done < <(jq -r 'select(.floating) | "\(.addr) \(.x) \(.y) \(.w) \(.h)"' "$placements")

  local multiplier force focused
  focused=$(hyprctl activewindow -j | jq -r '.address // empty')
  multiplier=$(hyprctl getoption dwindle:split_width_multiplier | awk 'NR == 1 {print $2}')
  force=$(hyprctl getoption dwindle:force_split | awk 'NR == 1 {print $2}')

  for ws in $(jq -r 'select(.floating | not) | .ws' "$placements" | sort -u); do
    wins=$(jq -sc --arg ws "$ws" 'map(select(.ws == $ws and (.floating | not)))' "$placements")
    (($(jq length <<<"$wins") > 1)) || continue
    plan=$(layout_plan <<<"$wins")
    if [[ -z $plan ]]; then
      log "arrange: $ws is not a dwindle layout, left as launched"
      continue
    fi

    # Apps still settling right after launch can knock a split off, so check
    # the result against the saved rectangles and rebuild when it is off
    local attempt off
    for attempt in 1 2 3; do
      # Park every window but the first as floating (floating windows are not
      # part of the tiling tree), then tile them back one split at a time.
      # Parking on another workspace would create and destroy it, and Hyprland
      # hides the special workspace on screen when that happens.
      local shown
      shown=$(hyprctl monitors -j | jq -r --arg ws "$ws" '.[] | select(.activeWorkspace.name == $ws or .specialWorkspace.name == $ws) | .name')
      # Dwindle splits the focused window whenever it sits on the workspace being
      # built, whatever the cursor says. Hand focus to a window that is already
      # on screen, which changes nothing visible.
      if [[ -z $shown ]] && [[ $(hyprctl activewindow -j | jq -r '.workspace.name // empty') == "$ws" ]]; then
        a=$(hyprctl clients -j | jq -r --argjson on "$(hyprctl monitors -j | jq -c 'map(.activeWorkspace.name, .specialWorkspace.name)')" \
          '[.[] | select(.workspace.name | IN($on[]))] | sort_by(.focusHistoryID) | first | .address // empty')
        [[ -n $a ]] && dispatch "hl.dsp.focus({ window = \"address:$a\" })"
      fi

      while read -r op a d b; do
        [[ $op == split ]] && dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$b\" })"
      done <<<"$plan"

      while read -r op a d b; do
        [[ $op == split ]] || continue
        if [[ -n $shown ]]; then
          # On screen, dwindle splits the focused window instead; it is
          # already visible, so focusing it there changes nothing on screen
          dispatch "hl.dsp.focus({ window = \"address:$a\" })"
          dispatch "hl.dsp.layout(\"preselect $d\")"
        else
          aim "$a" "$ws"
          if [[ $d == r ]]; then
            hyprctl eval "hl.config({ dwindle = { split_width_multiplier = 0.01, force_split = 2 } })" >/dev/null
          else
            hyprctl eval "hl.config({ dwindle = { split_width_multiplier = 100, force_split = 2 } })" >/dev/null
          fi
        fi
        dispatch "hl.dsp.window.float({ action = \"disable\", window = \"address:$b\" })"
      done <<<"$plan"
      hyprctl eval "hl.config({ dwindle = { split_width_multiplier = $multiplier, force_split = $force } })" >/dev/null

      # Two passes: each resize moves the splits the next window hangs off
      for _ in 1 2; do
        while read -r a w h; do
          dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = \"address:$a\" })"
        done < <(jq -r '.[] | "\(.addr) \(.w) \(.h)"' <<<"$wins")
      done

      off=$(hyprctl clients -j | jq -r --argjson w "$wins" '[$w[] as $s
        | (first(.[] | select(.address == $s.addr)) // null) as $c
        | select($c == null or ([($c.at[0] - $s.x), ($c.at[1] - $s.y), ($c.size[0] - $s.w), ($c.size[1] - $s.h)] | map(fabs) | max) > 12)
        | "\($s.addr) want \($s.x),\($s.y) \($s.w)x\($s.h) got \(if $c then "\($c.at[0]),\($c.at[1]) \($c.size[0])x\($c.size[1])" else "gone" end)"]
        | join("; ")')
      [[ -z $off ]] && break
      log "arrange: $ws attempt $attempt off (cursor $(hyprctl cursorpos)): $off"
      sleep 2
    done
    log "arrange: $ws rebuilt ($(jq length <<<"$wins") windows, attempt $attempt${off:+, still off})"
  done

  # Give focus back if that window is on screen (focusing a hidden one would show it)
  if [[ -n $focused ]] && hyprctl clients -j | jq -e --arg a "$focused" --argjson on "$(hyprctl monitors -j | jq -c 'map(.activeWorkspace.name, .specialWorkspace.name)')" \
    'any(.[]; .address == $a and (.workspace.name | IN($on[])))' >/dev/null; then
    dispatch "hl.dsp.focus({ window = \"address:$focused\" })"
  fi
}

case $1 in
  save) save ;;
  restore) restore ;;
  arrange) arrange "$2" ;; # re-run the layout step on a placements file (debugging)
  watch)
    save
    # Programs started inside a terminal fire no window event: save every 15s
    # too (the file is only rewritten when something changed)
    (while sleep 15; do save; done) &
    trap 'kill $! 2>/dev/null' EXIT
    pending=""
    socat -u "UNIX-CONNECT:$EVENTS" - | while read -r event; do
      case ${event%%>>*} in
        openwindow | movewindowv2) delay=1 ;;
        # Wait longer after a close: at shutdown all windows close and the
        # session ends before this fires, so the saved state stays intact.
        closewindow) delay=5 ;;
        *) continue ;;
      esac
      if shutting_down; then
        [[ -n $pending ]] && kill "$pending" 2>/dev/null
        log "watch: session ending, saving stopped"
        exit 0
      fi
      [[ -n $pending ]] && kill "$pending" 2>/dev/null
      (sleep "$delay" && save) &
      pending=$!
    done
    ;;
  *)
    echo "Usage: hypr-session <save|restore|watch>"
    exit 1
    ;;
esac
